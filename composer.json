{
  "name": "webilia/connect",
  "description": "Webilia Connect SDK for WordPress products.",
  "type": "library",
  "license": "MIT",
  "version": "1.0.1",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Webilia\\Connect\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webilia\\Connect\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "7.4.0"
    }
  }
}
